# 复制成 .env 再改。docker compose 会读它，直接 node server.mjs 也会读。

# Steam Web API 密钥（必填，否则读不到游戏库）
# 申请：https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# 监听端口 / 地址。放进 Docker 或 1Panel 运行环境时必须 0.0.0.0
PORT=8787
HOST=0.0.0.0

# 服务器连不上 Steam 时用的代理。
# 境外服务器留空；国内服务器填自己的代理地址（容器里访问宿主机用 host.docker.internal）
STEAM_PROXY=

# /demo 展示哪个账号的游戏库。
# 留空 = 用仓库自带的示例数据（data/demo-library.json），不联网也能看。
# 填了 17 位 steamID64 才会去抓真实库（需要 STEAM_API_KEY）。
DEMO_STEAM_ID=

# 封面来源：
#   auto   老路径和哈希路径并发，谁先给出真图用谁（默认）
#   hashed 优先新版哈希路径，最稳，冷启动每张多等 ~1s
#   legacy 只用老路径，最快，个别新游戏会没图
COVER_SOURCE=auto
